    "crons": ["10,40 0 * * *", "0,5,10,15,20,24,25,30,35,40,45,50,55 1-10,13-23 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "RADAR_SNAPSHOTS",
      "id": "ef5aab4de2784bf59b61c4d0f59d6861"
    }
  ]
}
